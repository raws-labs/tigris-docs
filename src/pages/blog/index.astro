---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<StarlightPage
  frontmatter={{
    title: "Blog",
    description:
      "Notes from the TiGrIS project — embedded ML, tiling, and the toolchain.",
    tableOfContents: false,
    editUrl: false,
  }}
  hasSidebar={false}
>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li class="post">
          <a class="post-title" href={`/blog/${p.id}/`}>
            {p.data.title}
          </a>
          <time class="post-date">{fmt(p.data.date)}</time>
          {p.data.excerpt && <p class="post-excerpt">{p.data.excerpt}</p>}
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post {
    padding: 1.4rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .post:first-child {
    border-top: 0;
    padding-top: 0;
  }
  /* Inherit the global content-link treatment (body-ish text + green underline
     that thickens on hover) — just larger/bolder for the title. */
  .post-title {
    display: inline-block;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .post-date {
    display: block;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    margin-top: 0.3rem;
  }
  .post-excerpt {
    margin: 0.6rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
