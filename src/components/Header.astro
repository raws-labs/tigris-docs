---
// Overrides Starlight's Header: wordmark on the left; the primary nav, theme
// toggle, GitHub icon and search floated together on the right.
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
// Our clean custom version picker (replaces the plugin's native <select>).
import VersionSelect from "./VersionSelect.astro";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>

  <div class="right-group sl-flex print:hidden">
    <nav class="header-nav" aria-label="Primary">
      <a href="/getting-started/quickstart/">Docs</a>
      <a href="/blog/">Blog</a>
    </nav>
    <span class="v-sep" aria-hidden="true"></span>
    <div class="controls sl-flex">
      <VersionSelect />
      <div class="social-icons sl-flex">
        <SocialIcons />
      </div>
      <ThemeSelect />
    </div>
    {shouldRenderSearch && (
      <>
        <span class="v-sep" aria-hidden="true"></span>
        <div class="search-wrapper sl-flex">
          <Search />
        </div>
      </>
    )}
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      justify-content: space-between;
      align-items: center;
      gap: var(--sl-nav-gap);
      height: 100%;
    }
    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }
    /* Kinde-style: generous spacing, muted vertical dividers between clusters. */
    .right-group {
      gap: 1.5rem;
      align-items: center;
      margin-inline-start: auto;
    }
    .header-nav {
      display: flex;
      gap: 1.75rem;
    }
    .header-nav a {
      font-size: var(--sl-text-base);
      font-weight: 500;
      color: var(--sl-color-text);
      text-decoration: none;
      white-space: nowrap;
    }
    .header-nav a:hover {
      color: var(--sl-color-text-accent);
    }
    .controls {
      align-items: center;
      gap: 1.3rem;
    }
    .social-icons {
      align-items: center;
    }
    /* Muted vertical divider between clusters. */
    .v-sep {
      flex: none;
      align-self: center;
      width: 1px;
      height: 1.5rem;
      background: var(--sl-color-gray-5);
    }

    /* On narrow screens the docs sidebar toggle + search carry navigation;
       keep the version + theme controls and search, tuck the rest away. */
    @media (max-width: 50rem) {
      .header-nav,
      .v-sep,
      .social-icons {
        display: none;
      }
    }
  }
</style>
