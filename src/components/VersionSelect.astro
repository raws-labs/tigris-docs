---
// Clean custom version picker (a styled dropdown, not the plugin's native
// <select>). Reads the versions plugin's config and links to the same page in
// each version.
import starlightVersionsConfig from "virtual:starlight-versions-config";

const pathname = Astro.url.pathname;
const versions = starlightVersionsConfig.versions;

// Split the current path into an optional version slug + the shared base path.
let activeSlug: string | undefined;
let basePath = pathname;
for (const v of versions) {
  if (pathname === `/${v.slug}` || pathname === `/${v.slug}/` || pathname.startsWith(`/${v.slug}/`)) {
    activeSlug = v.slug;
    basePath = pathname.slice(v.slug.length + 1) || "/";
    break;
  }
}
if (!basePath.startsWith("/")) basePath = "/" + basePath;

const entries = [
  { label: starlightVersionsConfig.current.label, href: basePath, active: activeSlug === undefined },
  ...versions.map((v) => ({
    label: v.label ?? v.slug,
    href: `/${v.slug}${basePath}`,
    active: activeSlug === v.slug,
  })),
];
const active = entries.find((e) => e.active) ?? entries[0];
---

<details class="version-select">
  <summary aria-label="Select documentation version">
    <span class="vs-label">{active.label}</span>
    <span class="vs-caret" aria-hidden="true">▾</span>
  </summary>
  <div class="vs-panel">
    {
      entries.map((e) => (
        <a
          href={e.href}
          class:list={["vs-item", { active: e.active }]}
          aria-current={e.active ? "true" : undefined}
        >
          {e.label}
        </a>
      ))
    }
  </div>
</details>

<style>
  .version-select {
    position: relative;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-text);
    cursor: pointer;
    list-style: none;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    white-space: nowrap;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }
  .vs-caret {
    font-size: 0.7em;
    transition: transform 0.15s ease;
  }
  .version-select[open] .vs-caret {
    transform: rotate(180deg);
  }
  .vs-panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    min-width: 8rem;
    padding: 0.3rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
  }
  .vs-item {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: 0.3rem;
    white-space: nowrap;
  }
  .vs-item:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
    color: var(--sl-color-text-accent);
  }
  .vs-item.active {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
</style>
