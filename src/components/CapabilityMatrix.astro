---
// Renders the operator/backend capability data (generated by the compiler) in
// four modes, mirroring the original Hugo `operator-capabilities` shortcode:
//   matrix | limits | fallbacks | unsupported
import caps from "../data/operator_capabilities_v1.json";

interface Props {
  mode?: "matrix" | "limits" | "fallbacks" | "unsupported";
}
const { mode = "matrix" } = Astro.props;

const operators = caps.operators ?? [];
const isUnsupported = (o: any) =>
  o.routes?.reference === "unsupported" && o.routes?.s8_ref === "unsupported";
const supported = operators.filter((o: any) => !isUnsupported(o));
const unsupported = operators.filter((o: any) => isUnsupported(o));
const accelBackends = ["esp-nn", "cmsis-nn"] as const;
---
{mode === "matrix" && (
  <div class="capability-table">
    <table>
      <caption>Executable operators after graph normalization</caption>
      <thead>
        <tr><th>Operator</th><th>Portable C</th><th>ESP-NN</th><th>CMSIS-NN</th></tr>
      </thead>
      <tbody>
        {supported.map((op: any) => (
          <tr>
            <th scope="row"><code>{op.operator}</code></th>
            <td>Float32 + int8</td>
            {accelBackends.map((b) => {
              const route = op.routes?.[b];
              const cond = op.conditional_fallbacks?.[b];
              return (
                <td title={cond ?? undefined}>
                  {route === "native" ? `Native${cond ? "*" : ""}` : "Portable fallback"}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{mode === "limits" && (
  <div class="capability-table">
    <table>
      <thead><tr><th>Operator</th><th>Implemented form</th></tr></thead>
      <tbody>
        {operators.flatMap((op: any) =>
          (op.constraints ?? []).map((c: string) => (
            <tr><th scope="row"><code>{op.operator}</code></th><td>{c}</td></tr>
          ))
        )}
      </tbody>
    </table>
  </div>
)}

{mode === "fallbacks" && (
  <div class="capability-table">
    <table>
      <thead><tr><th>Backend</th><th>Operator</th><th>Fallback condition</th></tr></thead>
      <tbody>
        {operators.flatMap((op: any) =>
          Object.entries(op.conditional_fallbacks ?? {}).map(([backend, cond]) => (
            <tr>
              <th scope="row"><code>{backend}</code></th>
              <td><code>{op.operator}</code></td>
              <td>{cond as string}</td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
)}

{mode === "unsupported" && (
  <p>
    {unsupported.map((op: any, i: number) => (
      <>{i > 0 ? ", " : ""}<code>{op.operator}</code></>
    ))}.
  </p>
)}
